        {
            "character": "Serena",
            "serenaSpeakerSprite": "SerenaUpset",
            "dialogue": "A what? Say it, Joan. Say it."
        },
        {
            "character": "Joan",
            "serenaSpeakerSprite": "JoanUpset",
            "dialogue": "Ah... Wait- I didn't mean it."
        },
        {
            "character": "Joan",
            "joanSpeakerSprite": "JoanUpset",
            "dialogue": "*Dangit, Joan! You're trying to get her attention, remember? This is your last chance! You can't screw this up!"
