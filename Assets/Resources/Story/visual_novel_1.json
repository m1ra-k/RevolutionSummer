{
    "dialogues": [
        {
            "character": "",
            "joanSpeakerSprite": "Transparent",
            "dialogue": "Awwwww... And Sonatine takes the win per usual! Guess Grand Mal still has a few things to learn, yea?"
        },
        {
            "character": "Serena",
            "serenaSpeakerSprite": "SerenaNeutral",
            "dialogue": "The first win is on us. We've only just gotten started. It won't be so easy the second time around."
        },
        {
            "character": "Joan",
            "joanSpeakerSprite": "JoanUpset",
            "dialogue": "On us? Seriously? There's a reason why I'm the main bassist and singer, and you're just a..."
